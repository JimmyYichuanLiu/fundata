# SQLite 数据库路径（相对于项目根目录）
DB_PATH=fund_data.db

# 校准数据库路径（data_quality_check.py 生成）
CLEAN_DB_PATH=fund_clean.db

# 163邮箱配置
# EMAIL_PASSWORD 填写 IMAP 授权码，不是登录密码
# 获取路径：163邮箱 → 设置 → POP3/SMTP/IMAP → 开启IMAP → 生成授权码
EMAIL_USER=your_email@163.com
EMAIL_PASSWORD=your_imap_auth_code

# API 服务配置
# 生产环境部署在 nginx 后面时，uvicorn 只监听本地，
# host/port 由 deploy/fundata-api.service 的 ExecStart 指定，这里的值仅供本地直接运行使用
API_HOST=0.0.0.0
API_PORT=8000

# A股行情实时轮询
# 设为 1 开启（交易时段每5分钟同步一次），默认 0（仅每日 11:30 和 15:15 两次快照）
# 服务器带宽有限时建议保持 0
MARKET_INTRADAY_MODE=0
