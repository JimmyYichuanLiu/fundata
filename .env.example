# SQLite 数据库路径（默认 fund_data.db）
DB_PATH=fund_data.db

# 校准数据库路径（数据质量检测脚本生成）
CLEAN_DB_PATH=fund_clean.db

# 163邮箱配置
EMAIL_USER=your_email@163.com
EMAIL_PASSWORD=your_imap_auth_code

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# A股行情实时轮询（交易时段每5分钟同步一次）
# 设为 1 开启，默认 0（仅每日 11:30 和 15:15 两次快照）
MARKET_INTRADAY_MODE=0
