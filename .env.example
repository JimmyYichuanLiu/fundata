# SQLite 数据库路径（相对于项目根目录）
DB_PATH=fund_data.db

# 校准数据库路径（data_quality_check.py 生成）
CLEAN_DB_PATH=fund_clean.db

# 163邮箱配置
# EMAIL_PASSWORD 填写 IMAP 授权码，不是登录密码
# 获取路径：163邮箱 → 设置 → POP3/SMTP/IMAP → 开启IMAP → 生成授权码
EMAIL_USER=your_email@163.com
EMAIL_PASSWORD=your_imap_auth_code

# API 服务配置
# 生产环境部署在 nginx 后面时，uvicorn 只监听本地，
# host/port 由 deploy/fundata-api.service 的 ExecStart 指定，这里的值仅供本地直接运行使用
API_HOST=127.0.0.1
API_PORT=8000

# A股行情实时轮询
# 设为 1 开启（交易时段每5分钟同步一次），默认 0（仅每日 11:30 和 15:15 两次快照）
# 服务器带宽有限时建议保持 0
MARKET_INTRADAY_MODE=0

# AISStream.io API Key（霍尔木兹海峡船舶监测）
# 注册地址：https://aisstream.io — 免费，无需 AIS 接收站
# 未设置时跳过 AIS 采集，霍尔木兹页面仍可访问但无数据
AISSTREAM_API_KEY=

# HTTP public deployment: admin login and all write/private API routes disabled.
FUNDATA_READONLY=1
FUNDATA_COOKIE_SECURE=1
FUNDATA_SCHEDULER_ENABLED=1
# Exact origins only. Never use * with administrator credentials.
FUNDATA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Local admin development ONLY: READONLY=0, COOKIE_SECURE=0;
# bind loopback and start uvicorn with --no-proxy-headers. Never use on a server.
